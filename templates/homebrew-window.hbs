                  <option value="blasphemy">{{localize "CAIN.Homebrew.Blasphemy"}}</option>
                  <option value="blasphemyPower">{{localize "CAIN.Homebrew.BlasphemyPower"}}</option>
                  <option value="bond">{{localize "CAIN.Homebrew.Bond"}}</option>
                  <option value="bondAbility">{{localize "CAIN.Homebrew.BondAbility"}}</option>
                  <option value="affliction">{{localize "CAIN.Homebrew.Affliction"}}</option>
                  <option value="item">{{localize "CAIN.Homebrew.Item"}}</option>
                  <option value="sinMark">{{localize "CAIN.Homebrew.SinMark"}}</option>
                </select>
              </div>

              <div class="form-section">
                <label for="reverse-import-item">{{localize "CAIN.Homebrew.SelectItemLabel"}}</label>
                <select id="reverse-import-item" class="homebrew-input" disabled>
                  <option value="">{{localize "CAIN.Homebrew.SelectTypeFirstOption"}}</option>
                </select>
              </div>

              <button type="button" class="btn-primary homebrew-load-item" disabled>
                <i class="fas fa-edit"></i> {{localize "CAIN.Homebrew.LoadIntoEditorBtn"}}
              </button>
            </div>

            <div class="reverse-import-info">
              <i class="fas fa-info-circle"></i>
              <span>{{localize "CAIN.Homebrew.LoadIntoEditorDesc"}}</span>
            </div>
          </div>
        </div>

        {{!-- EXPORT FORMAT GUIDE --}}
        <div class="format-guide">
          <details>
            <summary><i class="fas fa-book"></i> {{localize "CAIN.Homebrew.ExportFormatGuideTitle"}}</summary>
            <div class="guide-content">
              <p><strong>{{localize "CAIN.Homebrew.CatHelpSyntax"}}</strong> {{localize "CAIN.Homebrew.FormatGuide1"}}</p>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpSyntax"}}</strong> {{localize "CAIN.Homebrew.FormatGuide2"}}</p>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpSyntax"}}</strong> {{localize "CAIN.Homebrew.FormatGuide3"}}</p>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpSyntax"}}</strong> {{localize "CAIN.Homebrew.FormatGuide4"}}</p>
            </div>
          </details>
        </div>
      </div>
