<form class='{{cssClass}} homebrew-background' autocomplete='off'>
  <header class='sheet-header homebrew-header'>
    <h1 class="homebrew-title">
      <i class="fas fa-flask"></i> {{localize "CAIN.Homebrew.Title"}}
    </h1>
    <p class="homebrew-subtitle">{{localize "CAIN.Homebrew.Subtitle"}}</p>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs homebrew-tabs' data-group='primary'>
    <a class='item' data-tab='agenda'><i class="fas fa-tasks"></i> {{localize "CAIN.Homebrew.Agenda"}}</a>
    <a class='item' data-tab='blasphemy'><i class="fas fa-book-dead"></i> {{localize "CAIN.Homebrew.Blasphemy"}}</a>
    <a class='item' data-tab='blasphemyPower'><i class="fas fa-hand-sparkles"></i> {{localize "CAIN.Homebrew.Powers"}}</a>
    <a class='item' data-tab='bond'><i class="fas fa-heart"></i> {{localize "CAIN.Homebrew.Bond"}}</a>
    <a class='item' data-tab='bondAbility'><i class="fas fa-handshake"></i> {{localize "CAIN.Homebrew.BondAbilities"}}</a>
    <a class='item' data-tab='affliction'><i class="fas fa-skull-crossbones"></i> {{localize "CAIN.Homebrew.Afflictions"}}</a>
    <a class='item' data-tab='item'><i class="fas fa-briefcase"></i> {{localize "CAIN.Homebrew.Items"}}</a>
    <a class='item' data-tab='sinMark'><i class="fas fa-exclamation-triangle"></i> {{localize "CAIN.Homebrew.SinMarks"}}</a>
    <a class='item' data-tab='import-export'><i class="fas fa-file-import"></i> {{localize "CAIN.Homebrew.ImportExport"}}</a>
    <a class='item' data-tab='history'><i class="fas fa-history"></i> {{localize "CAIN.Homebrew.History"}}</a>
    <a class='item' data-tab='settings'><i class="fas fa-cog"></i> {{localize "CAIN.Homebrew.Settings"}}</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body homebrew-body'>

    {{!-- AGENDA TAB --}}
    <div class='tab homebrew-tab' data-group='primary' data-tab='agenda'>
       <div class="creation-panel">
        <h2><i class="fas fa-plus-circle"></i> {{localize "CAIN.Homebrew.CreateAgenda"}}</h2>

        <div class="form-section">
          <label for="agenda-name">{{localize "CAIN.Homebrew.AgendaName"}}</label>
          <input type="text" id="agenda-name" class="homebrew-input homebrew-agenda-name-input" placeholder="{{localize 'CAIN.Homebrew.EnterAgendaName'}}" value="{{agendaOptions.name}}">
        </div>

        <div class="form-section">
          <div class="section-header">
            <h3><i class="fas fa-list-ul"></i> {{localize "CAIN.Homebrew.AgendaTasks"}}</h3>
            <button type="button" class="btn-add homebrew-new-task"><i class="fas fa-plus"></i> {{localize "CAIN.Homebrew.AddTask"}}</button>
          </div>
          <ul class="task-list">
          {{#each agendaOptions.tasks}}
            <li class='task-item'>
              <textarea class="homebrew-input homebrew-task-input" data-task-index="{{@index}}" placeholder="{{localize 'CAIN.Homebrew.TaskDescPlaceholder'}}" style="font-weight: {{#if this.isBold}}bold{{else}}normal{{/if}};">{{this.task}}</textarea>
              <div class="task-controls">
                <button type="button" class="btn-icon homebrew-toggle-bold" data-task-index="{{@index}}" title="{{localize 'CAIN.Homebrew.BoldText'}}">
                  <i class="fas fa-bold {{#if this.isBold}}active{{/if}}"></i>
                </button>
                <button type="button" class="btn-icon btn-delete homebrew-remove-task" data-task-index="{{@index}}" title="{{localize 'CAIN.Remove'}}">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </li>
          {{/each}}
          </ul>
        </div>

        <div class="form-section">
          <div class="section-header">
            <h3><i class="fas fa-star"></i> {{localize "CAIN.Homebrew.AgendaAbilities"}}</h3>
            <button type="button" class="btn-add homebrew-new-ability"><i class="fas fa-plus"></i> {{localize "CAIN.Homebrew.AddAbility"}}</button>
          </div>
          <ul class="ability-list">
          {{#each agendaOptions.abilities}}
            <li class='ability-item'>
              <input type="text" class="homebrew-input homebrew-ability-name-input" data-ability-index="{{@index}}" placeholder="{{localize 'CAIN.Homebrew.AbilityNamePlaceholder'}}" value="{{this.name}}">
              <textarea class="homebrew-input homebrew-ability-input" data-ability-index="{{@index}}" placeholder="{{localize 'CAIN.Homebrew.AbilityDescPlaceholder'}}">{{this.abilityDescription}}</textarea>
              <button type="button" class="btn-icon btn-delete homebrew-remove-ability" data-ability-index="{{@index}}" title="{{localize 'CAIN.Remove'}}">
                <i class="fas fa-trash"></i>
              </button>
            </li>
          {{/each}}
          </ul>
        </div>

        <div class="cat-help">
          <details>
            <summary><i class="fas fa-question-circle"></i> {{localize "CAIN.Homebrew.CatHelp"}}</summary>
            <div class="cat-help-content">
              <p><strong>{{localize "CAIN.Homebrew.CatHelpSyntax"}}</strong> <code>{"{<CAT> type modifier}"}</code> or <code>{"{<CAT operation> type modifier}"}</code></p>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpValidTypes"}}</strong></p>
              <ul class="cat-type-list">
                <li><code>people</code> - {{localize "CAIN.Homebrew.CatHelpDescPeople"}}</li>
                <li><code>size</code> - {{localize "CAIN.Homebrew.CatHelpDescSize"}}</li>
                <li><code>area</code> - {{localize "CAIN.Homebrew.CatHelpDescArea"}}</li>
                <li><code>range</code> - {{localize "CAIN.Homebrew.CatHelpDescRange"}}</li>
                <li><code>speed</code> - {{localize "CAIN.Homebrew.CatHelpDescSpeed"}}</li>
                <li><code>magnitude</code> - {{localize "CAIN.Homebrew.CatHelpDescMagnitude"}}</li>
              </ul>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpModifier"}}</strong> {{localize "CAIN.Homebrew.CatHelpModifierDesc"}}</p>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpOperations"}}</strong> <code>/2</code>, <code>*2</code>, <code>+1</code>, <code>-1</code> {{localize "CAIN.Homebrew.CatHelpOperationsDesc"}}</p>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpExamples"}}</strong></p>
              <ul class="cat-example-list">
                <li><code>{"{<CAT> size 0}"}</code> - size at current CAT level</li>
                <li><code>{"{<CAT> people +1}"}</code> - people at CAT+1</li>
                <li><code>{"{<CAT/2> area 0}"}</code> - area at half CAT (rounded up)</li>
              </ul>
            </div>
          </details>
        </div>

        <footer class="form-footer">
          <button type="button" class="btn-primary homebrew-submit-agenda"><i class="fas fa-check-circle"></i> {{localize "CAIN.Homebrew.CreateAgenda"}}</button>
        </footer>
      </div>
    </div>

    {{!-- BLASPHEMY TAB --}}
    <div class='tab homebrew-tab' data-group='primary' data-tab='blasphemy'>
      <div class="creation-panel">
        <h2><i class="fas fa-plus-circle"></i> {{localize "CAIN.Homebrew.CreateBlasphemy"}}</h2>

        <div class="form-section">
          <label for="blasphemy-name">{{localize "CAIN.Homebrew.BlasphemyName"}}</label>
          <input type="text" id="blasphemy-name" class="homebrew-input homebrew-blasphemy-name-input" placeholder="{{localize 'CAIN.Homebrew.EnterBlasphemyName'}}" value="{{blasphemyOptions.name}}">
        </div>

        <div class="form-section">
          <div class="section-header">
            <h3><i class="fas fa-hand-sparkles"></i> {{localize "CAIN.Homebrew.Powers"}}</h3>
            <button type="button" class="btn-add homebrew-new-power"><i class="fas fa-plus"></i> {{localize "CAIN.Abilities.AddPower"}}</button>
          </div>
          <ul class="power-list">
          {{#each blasphemyOptions.powers}}
            <li class='power-item'>
              <div class="power-header-row">
                <input type="text" class="homebrew-input homebrew-power-name-input" data-power-index="{{@index}}" placeholder="{{localize 'CAIN.Homebrew.PowerNamePlaceholder'}}" value="{{this.name}}">
                <label class="checkbox-label">
                  <input type="checkbox" class="homebrew-power-passive-input" data-power-index="{{@index}}" {{#if this.isPassive}}checked{{/if}}>
                  <span>{{localize "CAIN.Abilities.Passive"}}</span>
                </label>
                <button type="button" class="btn-icon btn-delete homebrew-remove-power" data-power-index="{{@index}}" title="{{localize 'CAIN.Remove'}}">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
              <div class="power-details">
                <div class="psyche-burst-options">
                  <label class="psyche-label">{{localize "CAIN.Psyche"}}:</label>
                  <label class="checkbox-label small">
                    <input type="checkbox" class="homebrew-power-psyche-cost" data-power-index="{{@index}}" {{#if this.psycheBurstCost}}checked{{/if}}>
                    <span><i class="fas fa-circle"></i> {{localize "CAIN.Homebrew.Uses"}}</span>
                  </label>
                  <label class="checkbox-label small">
                    <input type="checkbox" class="homebrew-power-psyche-no-cost" data-power-index="{{@index}}" {{#if this.psycheBurstNoCost}}checked{{/if}}>
                    <span><i class="fas fa-times"></i> {{localize "CAIN.Abilities.HasNoPsycheMode"}}</span>
                  </label>
                  <label class="checkbox-label small">
                    <input type="checkbox" class="homebrew-power-psyche-mult" data-power-index="{{@index}}" {{#if this.psycheBurstMultCost}}checked{{/if}}>
                    <span><i class="fas fa-plus"></i> {{localize "CAIN.Homebrew.Multiple"}}</span>
                  </label>
                </div>
                <input type="text" class="homebrew-input homebrew-power-tags-input" data-power-index="{{@index}}" placeholder="{{localize 'CAIN.Homebrew.KeywordsPlaceholder'}}" value="{{this.keywords}}">
                <textarea class="homebrew-input homebrew-power-input" data-power-index="{{@index}}" placeholder="{{localize 'CAIN.Homebrew.PowerDesc'}}">{{this.powerDescription}}</textarea>
              </div>
            </li>
          {{/each}}
          </ul>
        </div>

        <div class="cat-help">
          <details>
            <summary><i class="fas fa-question-circle"></i> {{localize "CAIN.Homebrew.CatHelp"}}</summary>
            <div class="cat-help-content">
              <p><strong>{{localize "CAIN.Homebrew.CatHelpSyntax"}}</strong> <code>{"{<CAT> type modifier}"}</code> or <code>{"{<CAT operation> type modifier}"}</code></p>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpValidTypes"}}</strong> <code>people</code>, <code>size</code>, <code>area</code>, <code>range</code>, <code>speed</code>, <code>magnitude</code></p>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpExamples"}}</strong> <code>{"{<CAT> size 0}"}</code>, <code>{"{<CAT> people +1}"}</code>, <code>{"{<CAT/2> area 0}"}</code></p>
            </div>
          </details>
        </div>

        <footer class="form-footer">
          <button type="button" class="btn-primary homebrew-submit-blasphemy"><i class="fas fa-check-circle"></i> {{localize "CAIN.Homebrew.CreateBlasphemy"}}</button>
        </footer>
      </div>
    </div>

    {{!-- BLASPHEMY POWER TAB --}}
    <div class='tab homebrew-tab' data-group='primary' data-tab='blasphemyPower'>
      <div class="creation-panel">
        <h2><i class="fas fa-plus-circle"></i> {{localize "CAIN.Homebrew.CreateStandalonePower"}}</h2>

        <div class="form-section">
          <label for="power-standalone-name">{{localize "CAIN.Homebrew.PowerName"}}</label>
          <input type="text" id="power-standalone-name" class="homebrew-input" placeholder="{{localize 'CAIN.Homebrew.EnterPowerName'}}">
        </div>

        <div class="form-section">
          <label class="checkbox-label">
            <input type="checkbox" id="power-standalone-passive">
            <span>{{localize "CAIN.Abilities.IsPassive"}}</span>
          </label>
        </div>

        <div class="form-section">
          <label>{{localize "CAIN.Abilities.PsycheBurstOptions"}}</label>
          <div class="psyche-burst-options">
            <label class="checkbox-label">
              <input type="checkbox" id="power-standalone-psyche-cost">
              <span><i class="fas fa-circle"></i> {{localize "CAIN.Abilities.UsesPsycheBurst"}}</span>
            </label>
            <label class="checkbox-label">
              <input type="checkbox" id="power-standalone-psyche-no-cost">
              <span><i class="fas fa-times"></i> {{localize "CAIN.Abilities.HasNoPsycheMode"}}</span>
            </label>
            <label class="checkbox-label">
              <input type="checkbox" id="power-standalone-psyche-mult">
              <span><i class="fas fa-plus"></i> {{localize "CAIN.Abilities.CanUseMultipleBursts"}}</span>
            </label>
          </div>
        </div>

        <div class="form-section">
          <label for="power-standalone-keywords">{{localize "CAIN.Keywords"}}</label>
          <input type="text" id="power-standalone-keywords" class="homebrew-input" placeholder="{{localize 'CAIN.Homebrew.KeywordsPlaceholder'}}">
        </div>

        <div class="form-section">
          <label for="power-standalone-description">{{localize "CAIN.Homebrew.PowerDesc"}}</label>
          <textarea id="power-standalone-description" class="homebrew-input" rows="6" placeholder="{{localize 'CAIN.Homebrew.PowerDesc'}}"></textarea>
        </div>

        <div class="cat-help">
          <details>
            <summary><i class="fas fa-question-circle"></i> {{localize "CAIN.Homebrew.CatHelp"}}</summary>
            <div class="cat-help-content">
              <p><strong>{{localize "CAIN.Homebrew.CatHelpSyntax"}}</strong> <code>{"{<CAT> type modifier}"}</code> or <code>{"{<CAT operation> type modifier}"}</code></p>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpValidTypes"}}</strong> <code>people</code>, <code>size</code>, <code>area</code>, <code>range</code>, <code>speed</code>, <code>magnitude</code></p>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpExamples"}}</strong> <code>{"{<CAT> size 0}"}</code>, <code>{"{<CAT> people +1}"}</code>, <code>{"{<CAT/2> area 0}"}</code></p>
            </div>
          </details>
        </div>

        <footer class="form-footer">
          <button type="button" class="btn-primary homebrew-submit-standalone-power"><i class="fas fa-check-circle"></i> {{localize "CAIN.Homebrew.CreatePower"}}</button>
        </footer>
      </div>
    </div>

    {{!-- BOND TAB --}}
    <div class='tab homebrew-tab' data-group='primary' data-tab='bond'>
      <div class="creation-panel bond-panel">
        <h2><i class="fas fa-plus-circle"></i> {{localize "CAIN.Homebrew.CreateBond"}}</h2>

        <div class="form-section">
          <label for="bond-name">{{localize "CAIN.Homebrew.BondName"}}</label>
          <input type="text" id="bond-name" class="homebrew-input" placeholder="{{localize 'CAIN.Homebrew.EnterBondName'}}">
        </div>

        <div class="form-section">
          <label for="bond-virtue-name">{{localize "CAIN.VirtueName"}}</label>
          <input type="text" id="bond-virtue-name" class="homebrew-input" placeholder="{{localize 'CAIN.Homebrew.EnterVirtueName'}}">
        </div>

        <div class="form-section">
          <label for="bond-high-blasphemy-level">{{localize "CAIN.Bonds.UnlockedAtLevel"}}</label>
          <select id="bond-high-blasphemy-level" class="homebrew-input">
            <option value="0">{{localize "CAIN.Bonds.Level0Immediate"}}</option>
            <option value="1" selected>{{localize "CAIN.Lvl" level=1}}</option>
            <option value="2">{{localize "CAIN.Lvl" level=2}}</option>
            <option value="3">{{localize "CAIN.Lvl" level=3}}</option>
          </select>
          <p class="settings-hint">{{localize "CAIN.Homebrew.HighBlasphemyLevelHint"}}</p>
        </div>

        <div class="form-section">
          <div class="section-header">
            <h3><i class="fas fa-scroll"></i> {{localize "CAIN.Abilities.Strictures"}}</h3>
            <button type="button" class="btn-add homebrew-new-stricture"><i class="fas fa-plus"></i> {{localize "CAIN.Homebrew.AddStricture"}}</button>
          </div>
          <p class="settings-hint">{{localize "CAIN.Homebrew.StricturesHint"}}</p>
          <ul class="stricture-list" id="bond-stricture-list">
          {{#each bondOptions.strictures}}
            <li class='stricture-item'>
              <span class="stricture-number"></span>
              <textarea class="homebrew-input homebrew-stricture-input" data-stricture-index="{{@index}}" placeholder="{{localize 'CAIN.Homebrew.StricturePlaceholder'}}">{{this}}</textarea>
              <button type="button" class="btn-icon btn-delete homebrew-remove-stricture" data-stricture-index="{{@index}}" title="{{localize 'CAIN.Homebrew.RemoveStricture'}}">
                <i class="fas fa-trash"></i>
              </button>
            </li>
          {{else}}
            <li class="stricture-empty-state">
              <i class="fas fa-scroll"></i>
              <span>{{localize "CAIN.Homebrew.NoStricturesHint"}}</span>
            </li>
          {{/each}}
          </ul>
        </div>

        <div class="bond-info">
          <details>
            <summary><i class="fas fa-info-circle"></i> {{localize "CAIN.Homebrew.BondSystemInfo"}}</summary>
            <div class="bond-info-content">
              <p><strong>{{localize "CAIN.Sheet.Talismans"}}</strong> {{localize "CAIN.Homebrew.BondInfo1"}}</p>
              <p><strong>{{localize "CAIN.Abilities.Strictures"}}</strong> {{localize "CAIN.Homebrew.BondInfo2"}}</p>
              <p><strong>{{localize "CAIN.Abilities.HighBlasphemyPower"}}</strong> {{localize "CAIN.Homebrew.BondInfo3"}}</p>
              <p><strong>{{localize "CAIN.Homebrew.BondAbilities"}}</strong> {{localize "CAIN.Homebrew.BondInfo4"}}</p>
            </div>
          </details>
        </div>

        <footer class="form-footer">
          <button type="button" class="btn-primary homebrew-submit-bond"><i class="fas fa-check-circle"></i> {{localize "CAIN.Homebrew.CreateBond"}}</button>
        </footer>
      </div>
    </div>

    {{!-- BOND ABILITY TAB --}}
    <div class='tab homebrew-tab' data-group='primary' data-tab='bondAbility'>
      <div class="creation-panel bond-ability-panel">
        <h2><i class="fas fa-plus-circle"></i> {{localize "CAIN.Homebrew.CreateBondAbility"}}</h2>

        <div class="form-section">
          <label for="bond-ability-name">{{localize "CAIN.AbilityName"}}</label>
          <input type="text" id="bond-ability-name" class="homebrew-input" placeholder="{{localize 'CAIN.Homebrew.EnterBondAbilityName'}}">
        </div>

        <div class="form-section">
          <label for="bond-ability-level">{{localize "CAIN.Bonds.LevelRequired"}}</label>
          <select id="bond-ability-level" class="homebrew-input">
            <option value="0">{{localize "CAIN.Bonds.Level0Immediate"}}</option>
            <option value="1">{{localize "CAIN.Bonds.Level1Desc"}}</option>
            <option value="2">{{localize "CAIN.Bonds.Level2Desc"}}</option>
            <option value="3">{{localize "CAIN.Bonds.Level3Desc"}}</option>
          </select>
        </div>

        <div class="form-section">
          <label for="bond-ability-description">{{localize "CAIN.AbilityDescription"}}</label>
          <textarea id="bond-ability-description" class="homebrew-input" rows="6" placeholder="{{localize 'CAIN.Bonds.AbilityDescPlaceholder'}}"></textarea>
        </div>

        <div class="form-section">
          <label class="checkbox-label">
            <input type="checkbox" id="bond-ability-permanent" checked>
            <span>{{localize "CAIN.Bonds.PermanentAbility"}}</span>
          </label>
          <p class="settings-hint">{{localize "CAIN.Bonds.PermanentAbilityHint"}}</p>
        </div>

        <div class="form-section psyche-section">
          <h3><i class="fas fa-brain"></i> {{localize "CAIN.Abilities.PsycheBurstOptions"}}</h3>
          <label class="checkbox-label">
            <input type="checkbox" id="bond-ability-requires-psyche">
            <span>{{localize "CAIN.Abilities.UsesPsycheBurst"}}</span>
          </label>
          <p class="settings-hint">{{localize "CAIN.Bonds.RequiresPsycheHint"}}</p>

          <div class="psyche-cost-field" id="bond-ability-psyche-cost-field" style="display: none;">
            <label for="bond-ability-psyche-cost">{{localize "CAIN.Bonds.PsycheBurstCostLabel"}}</label>
            <input type="number" id="bond-ability-psyche-cost" class="homebrew-input" value="1" min="0">
            <p class="settings-hint">{{localize "CAIN.Bonds.Cost0Hint"}}</p>
          </div>
        </div>

        <footer class="form-footer">
          <button type="button" class="btn-primary homebrew-submit-bond-ability"><i class="fas fa-check-circle"></i> {{localize "CAIN.Homebrew.CreateBondAbility"}}</button>
        </footer>
      </div>
    </div>

    {{!-- AFFLICTION TAB --}}
    <div class='tab homebrew-tab' data-group='primary' data-tab='affliction'>
      <div class="creation-panel">
        <h2><i class="fas fa-plus-circle"></i> {{localize "CAIN.Homebrew.CreateAffliction"}}</h2>

        <div class="form-section">
          <label for="affliction-name">{{localize "CAIN.Homebrew.AfflictionName"}}</label>
          <input type="text" id="affliction-name" class="homebrew-input" placeholder="{{localize 'CAIN.Homebrew.EnterAfflictionName'}}">
        </div>

        <div class="form-section">
          <label for="affliction-description">{{localize "CAIN.Description"}}</label>
          <textarea id="affliction-description" class="homebrew-input" rows="6" placeholder="{{localize 'CAIN.Homebrew.EnterAfflictionDesc'}}"></textarea>
        </div>

        <div class="cat-help">
          <details>
            <summary><i class="fas fa-question-circle"></i> {{localize "CAIN.Homebrew.CatHelp"}}</summary>
            <div class="cat-help-content">
              <p><strong>{{localize "CAIN.Homebrew.CatHelpSyntax"}}</strong> <code>{"{<CAT> type modifier}"}</code> or <code>{"{<CAT operation> type modifier}"}</code></p>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpValidTypes"}}</strong> <code>people</code>, <code>size</code>, <code>area</code>, <code>range</code>, <code>speed</code>, <code>magnitude</code></p>
              <p><strong>{{localize "CAIN.Homebrew.CatHelpExamples"}}</strong> <code>{"{<CAT> size 0}"}</code>, <code>{"{<CAT> people +1}"}</code>, <code>{"{<CAT/2> area 0}"}</code></p>
            </div>
          </details>
        </div>

        <footer class="form-footer">
          <button type="button" class="btn-primary homebrew-submit-affliction"><i class="fas fa-check-circle"></i> {{localize "CAIN.Homebrew.CreateAffliction"}}</button>
        </footer>
      </div>
    </div>

    {{!-- ITEM TAB --}}
    <div class='tab homebrew-tab' data-group='primary' data-tab='item'>
      <div class="creation-panel">
        <h2><i class="fas fa-plus-circle"></i> {{localize "CAIN.Homebrew.CreateItem"}}</h2>

        <div class="form-section">
          <label for="item-name">{{localize "CAIN.Homebrew.ItemName"}}</label>
          <input type="text" id="item-name" class="homebrew-input" placeholder="{{localize 'CAIN.Homebrew.EnterItemName'}}">
        </div>

        <div class="form-section">
          <label for="item-description">{{localize "CAIN.Description"}}</label>
          <textarea id="item-description" class="homebrew-input" rows="6" placeholder="{{localize 'CAIN.DescriptionPlaceholder'}}"></textarea>
        </div>

        <div class="form-section">
          <label for="item-quantity">{{localize "CAIN.Quantity"}}</label>
          <input type="number" id="item-quantity" class="homebrew-input" min="1" value="1">
        </div>

        <div class="form-section">
          <label for="item-weight">{{localize "CAIN.Weight"}}</label>
          <input type="number" id="item-weight" class="homebrew-input" min="0" step="0.1" value="0">
        </div>

        <footer class="form-footer">
          <button type="button" class="btn-primary homebrew-submit-item"><i class="fas fa-check-circle"></i> {{localize "CAIN.Homebrew.CreateItem"}}</button>
        </footer>
      </div>
    </div>

    {{!-- SIN MARK TAB --}}
    <div class='tab homebrew-tab' data-group='primary' data-tab='sinMark'>
      <div class="creation-panel">
        <h2><i class="fas fa-plus-circle"></i> {{localize "CAIN.Homebrew.CreateSinMark"}}</h2>

        <div class="form-section">
          <label for="sinmark-name">{{localize "CAIN.Homebrew.SinMarkName"}}</label>
          <input type="text" id="sinmark-name" class="homebrew-input" placeholder="{{localize 'CAIN.Homebrew.EnterSinMarkName'}}">
        </div>

        <div class="form-section">
          <label for="sinmark-description">{{localize "CAIN.Description"}}</label>
          <textarea id="sinmark-description" class="homebrew-input" rows="4" placeholder="{{localize 'CAIN.Homebrew.EnterSinMarkDesc'}}"></textarea>
        </div>

        <div class="form-section">
          <div class="section-header">
            <h3><i class="fas fa-star"></i> {{localize "CAIN.Homebrew.SinMarkAbilities"}}</h3>
            <button type="button" class="btn-add homebrew-new-sinmark-ability"><i class="fas fa-plus"></i> {{localize "CAIN.Homebrew.AddTask"}}</button>
          </div>
          <ul class="ability-list">
          {{#each sinMarkOptions.abilities}}
            <li class='ability-item'>
              <input type="text" class="homebrew-input homebrew-sinmark-ability-name-input" data-sinmark-ability-index="{{@index}}" placeholder="{{localize 'CAIN.Homebrew.SinMarkAbilityName'}}" value="{{this.name}}">
              <textarea class="homebrew-input homebrew-sinmark-ability-description-input" data-sinmark-ability-index="{{@index}}" placeholder="{{localize 'CAIN.Homebrew.EnterSinMarkAbilityDesc'}}">{{this.abilityDescription}}</textarea>
