                  <li>{{localize "CAIN.Homebrew.ImportStep2"}}</li>
                  <li>{{localize "CAIN.Homebrew.ImportStep3"}}</li>
                  <li>{{localize "CAIN.Homebrew.ImportStep4"}}</li>
