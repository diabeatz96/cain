                <i class="fas fa-trash"></i>
              </button>
            </li>
          {{/each}}
          </ul>
        </div>

        <footer class="form-footer">
          <button type="button" class="btn-primary homebrew-submit-sinmark"><i class="fas fa-check-circle"></i> {{localize "CAIN.Homebrew.CreateSinMark"}}</button>
