<div class="hunt-tracker-content">
  {{#if isGM}}
    {{#if hunt.active}}
      {{!-- Active Hunt Display --}}
      <div class="hunt-header">
        <div class="sin-info">
          <h3 class="sin-name">{{hunt.sinName}}</h3>
          <div class="sin-details">
            <span class="sin-type">{{hunt.sinType}}</span>
            <span class="sin-category">CAT {{hunt.sinCategory}}</span>
          </div>
        </div>
        <div class="hunt-phase">
          <label>{{localize "CAIN.HuntTracker.Phase"}}</label>
          <select class="phase-select">
            {{#each huntPhases}}
              <option value="{{this.id}}" {{#if (eq this.id ../hunt.phase)}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      {{!-- Tension Talisman --}}
      <div class="hunt-talisman-section hunt-tension-section">
        <div class="hunt-talisman-header">
          <h4>{{localize "CAIN.HuntTracker.TensionTalisman"}}</h4>
          <span class="hunt-talisman-value">{{tensionCurrent}}/{{tensionMax}}</span>
        </div>
        {{#if linkedTensionTalisman}}
          <div class="hunt-linked-talisman-display">
            <img src="{{linkedTensionTalisman.imagePath}}" alt="{{linkedTensionTalisman.name}}" class="hunt-linked-talisman-image" />
            <button type="button" data-action="unlinkTensionTalisman" class="hunt-unlink-btn" title="{{localize 'CAIN.HuntTracker.UnlinkTalisman'}}">
              <i class="fas fa-unlink"></i>
            </button>
          </div>
        {{else}}
          <div class="hunt-talisman-pips">
            {{#range 0 tensionMax}}
              <span class="hunt-pip {{#if (lt index ../tensionCurrent)}}filled{{/if}}"></span>
            {{/range}}
          </div>
        {{/if}}
        <div class="hunt-talisman-controls">
          <button type="button" data-action="decrementTension" title="{{localize 'CAIN.HuntTracker.DecreaseTension'}}">
            <i class="fas fa-minus"></i>
          </button>
          <button type="button" data-action="incrementTension" title="{{localize 'CAIN.HuntTracker.IncreaseTension'}}">
            <i class="fas fa-plus"></i>
          </button>
          <button type="button" data-action="advanceScene" title="{{localize 'CAIN.HuntTracker.ScenePassedHint'}}">
            <i class="fas fa-forward"></i> {{localize "CAIN.HuntTracker.Scene"}}
          </button>
          <button type="button" data-action="riskTriggered" class="{{#if hunt.tension.sceneRiskTriggered}}disabled{{/if}}" title="{{localize 'CAIN.HuntTracker.RiskRoll1Hint'}}">
            <i class="fas fa-dice-one"></i> {{localize "CAIN.HuntTracker.Risk1"}}
          </button>
          {{#unless linkedTensionTalisman}}
            <button type="button" data-action="linkTensionTalisman" title="{{localize 'CAIN.HuntTracker.LinkTalismanHint'}}">
              <i class="fas fa-link"></i> {{localize "CAIN.HuntTracker.Link"}}
            </button>
          {{/unless}}
        </div>
        {{#if hunt.tension.sceneRiskTriggered}}
          <div class="hunt-risk-triggered-notice">{{localize "CAIN.HuntTracker.RiskTriggeredNotice"}}</div>
        {{/if}}
      </div>

      {{!-- Pressure Talisman --}}
      <div class="hunt-talisman-section hunt-pressure-section {{#if hunt.pressure.outOfControl}}out-of-control{{/if}}">
        <div class="hunt-talisman-header">
          <h4>{{localize "CAIN.HuntTracker.PressureTalisman"}}</h4>
          <span class="hunt-talisman-value">{{pressureCurrent}}/{{pressureMax}}</span>
        </div>
        {{#if linkedPressureTalisman}}
          <div class="hunt-linked-talisman-display">
            <img src="{{linkedPressureTalisman.imagePath}}" alt="{{linkedPressureTalisman.name}}" class="hunt-linked-talisman-image" />
            <button type="button" data-action="unlinkPressureTalisman" class="hunt-unlink-btn" title="{{localize 'CAIN.HuntTracker.UnlinkTalisman'}}">
              <i class="fas fa-unlink"></i>
            </button>
          </div>
        {{else}}
          <div class="hunt-talisman-pips">
            {{#range 0 pressureMax}}
              <span class="hunt-pip {{#if (lt index ../pressureCurrent)}}filled{{/if}}"></span>
            {{/range}}
          </div>
        {{/if}}
        <div class="hunt-talisman-controls">
          <button type="button" data-action="decrementPressure" title="{{localize 'CAIN.HuntTracker.DecreasePressure'}}">
            <i class="fas fa-minus"></i>
          </button>
          <button type="button" data-action="incrementPressure" title="{{localize 'CAIN.HuntTracker.IncreasePressure'}}">
            <i class="fas fa-plus"></i>
          </button>
          <button type="button" data-action="partyRests" title="{{localize 'CAIN.HuntTracker.PartyRestsHint'}}">
            <i class="fas fa-bed"></i> {{localize "CAIN.HuntTracker.Rest"}}
          </button>
          {{#unless linkedPressureTalisman}}
            <button type="button" data-action="linkPressureTalisman" title="{{localize 'CAIN.HuntTracker.LinkTalismanHint'}}">
              <i class="fas fa-link"></i> {{localize "CAIN.HuntTracker.Link"}}
            </button>
          {{/unless}}
        </div>
        {{#if hunt.pressure.outOfControl}}
          <div class="hunt-overflow-warning">{{localize "CAIN.HuntTracker.PressureWarning"}}</div>
        {{/if}}
      </div>

      {{!-- Execution Talisman --}}
      <div class="hunt-talisman-section hunt-execution-section">
        <div class="hunt-talisman-header">
          <h4>{{localize "CAIN.HuntTracker.ExecutionTalisman"}}</h4>
          <span class="hunt-talisman-value">{{hunt.execution.current}}/{{executionMax}}</span>
        </div>
        {{#if linkedTalisman}}
          <div class="hunt-linked-talisman-display">
            <img src="{{linkedTalisman.imagePath}}" alt="{{linkedTalisman.name}}" class="hunt-linked-talisman-image" />
            <button type="button" data-action="unlinkTalisman" class="hunt-unlink-btn" title="{{localize 'CAIN.HuntTracker.UnlinkTalisman'}}">
              <i class="fas fa-unlink"></i>
            </button>
          </div>
        {{else}}
          <div class="hunt-execution-formula">
            <span>6 + {{hunt.pressure.current}} ({{localize "CAIN.HuntTracker.PressureLabel"}}) + {{hunt.sinCategory}} (CAT) = {{executionMax}}</span>
          </div>
          <div class="hunt-execution-bar">
            <div class="hunt-execution-fill" style="width: {{calcPercentage hunt.execution.current executionMax}}%"></div>
          </div>
        {{/if}}
        <div class="hunt-talisman-controls">
          <button type="button" data-action="decrementExecution" title="{{localize 'CAIN.HuntTracker.RemoveSlash'}}">
            <i class="fas fa-minus"></i>
          </button>
          <button type="button" data-action="incrementExecution" title="{{localize 'CAIN.HuntTracker.AddSlash'}}">
            <i class="fas fa-plus"></i>
          </button>
          <button type="button" data-action="healSin" title="{{localize 'CAIN.HuntTracker.SinHealsHint'}}">
            <i class="fas fa-heart"></i> {{localize "CAIN.HuntTracker.Heal"}}
          </button>
          <button type="button" data-action="togglePalace" class="{{#if hunt.insidePalace}}active{{/if}}" title="{{localize 'CAIN.HuntTracker.TogglePalaceHint'}}">
            <i class="fas fa-dungeon"></i> {{#if hunt.insidePalace}}{{localize "CAIN.HuntTracker.InPalace"}}{{else}}{{localize "CAIN.HuntTracker.Outside"}}{{/if}}
          </button>
          {{#unless linkedTalisman}}
            <button type="button" data-action="linkTalisman" title="{{localize 'CAIN.HuntTracker.LinkTalismanHint'}}">
              <i class="fas fa-link"></i> {{localize "CAIN.HuntTracker.Link"}}
            </button>
          {{/unless}}
        </div>
        {{#if hunt.insidePalace}}
          <div class="hunt-palace-notice">{{localize "CAIN.HuntTracker.PalaceNotice"}}</div>
        {{/if}}
      </div>

      {{!-- Traumas Section --}}
      <div class="hunt-traumas-section">
        <h4>{{localize "CAIN.HuntTracker.Traumas"}}</h4>
        {{#each hunt.traumas}}
          <div class="hunt-trauma-item {{#if this.discovered}}discovered{{/if}} {{#if this.used}}used{{/if}}">
            <div class="hunt-trauma-status">
              {{#if this.used}}
                <i class="fas fa-times-circle" title="{{localize 'CAIN.HuntTracker.Used'}}"></i>
              {{else if this.discovered}}
                <i class="fas fa-check-circle" title="{{localize 'CAIN.HuntTracker.Discovered'}}"></i>
              {{else}}
                <i class="fas fa-question-circle" title="{{localize 'CAIN.HuntTracker.Unknown'}}"></i>
              {{/if}}
            </div>
            <div class="hunt-trauma-content">
              <input type="text" class="hunt-trauma-question" value="{{this.question}}" placeholder="{{localize 'CAIN.HuntTracker.QuestionPlaceholder'}}" data-index="{{@index}}" />
              <input type="text" class="hunt-trauma-answer" value="{{this.answer}}" placeholder="{{localize 'CAIN.HuntTracker.AnswerPlaceholder'}}" data-index="{{@index}}" />
            </div>
            <div class="hunt-trauma-actions">
              {{#unless this.discovered}}
                <button type="button" data-action="discoverTrauma" data-index="{{@index}}" title="{{localize 'CAIN.HuntTracker.DiscoverTraumaHint'}}">
                  <i class="fas fa-eye"></i>
                </button>
              {{else}}
                {{#unless this.used}}
                  <button type="button" data-action="useTraumaCounter" data-index="{{@index}}" title="{{localize 'CAIN.HuntTracker.UseCounterHint'}}">
                    <i class="fas fa-bolt"></i>
                  </button>
                {{/unless}}
                <button type="button" data-action="resetTrauma" data-index="{{@index}}" title="{{localize 'CAIN.HuntTracker.ResetTraumaHint'}}">
                  <i class="fas fa-undo"></i>
                </button>
              {{/unless}}
            </div>
          </div>
        {{/each}}
      </div>

      {{!-- Tension Moves Section --}}
      <div class="hunt-tension-moves-section">
        <div class="hunt-section-header">
          <h4>{{localize "CAIN.HuntTracker.TensionMoves"}}</h4>
          <button type="button" data-action="rollRandomTensionMove" title="{{localize 'CAIN.HuntTracker.RollRandomMoveHint'}}">
            <i class="fas fa-dice"></i> {{localize "CAIN.HuntTracker.Random"}}
          </button>
        </div>
        <div class="hunt-tension-moves-list collapsed">
          {{#each tensionMoves}}
            <div class="hunt-tension-move">
              <strong>{{this.name}}:</strong> {{this.description}}
            </div>
          {{/each}}
        </div>
      </div>

      {{!-- Custom Clocks Section --}}
      <div class="hunt-custom-clocks-section">
        <div class="hunt-section-header">
          <h4>{{localize "CAIN.HuntTracker.CustomClocks"}}</h4>
          <button type="button" data-action="addCustomClock" title="{{localize 'CAIN.HuntTracker.AddClockHint'}}">
            <i class="fas fa-plus"></i> {{localize "CAIN.Add"}}
          </button>
        </div>
        {{#each hunt.customTalismans}}
          <div class="hunt-custom-clock">
            <span class="hunt-clock-name">{{this.name}}</span>
            <div class="hunt-clock-pips">
              {{#range 0 this.max}}
                <span class="hunt-pip {{#if (lt index ../current)}}filled{{/if}}"></span>
              {{/range}}
            </div>
            <span class="hunt-clock-value">{{this.current}}/{{this.max}}</span>
            <div class="hunt-clock-controls">
              <button type="button" data-action="untickCustomClock" data-clock-id="{{this.id}}" title="{{localize 'CAIN.HuntTracker.UntickHint'}}">
                <i class="fas fa-minus"></i>
              </button>
              <button type="button" data-action="tickCustomClock" data-clock-id="{{this.id}}" title="{{localize 'CAIN.HuntTracker.TickHint'}}">
                <i class="fas fa-plus"></i>
              </button>
              <button type="button" data-action="removeCustomClock" data-clock-id="{{this.id}}" title="{{localize 'CAIN.Remove'}}">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>
        {{/each}}
      </div>

      {{!-- Notes Section --}}
      <div class="hunt-notes-section">
        <h4>{{localize "CAIN.GMNotes"}}</h4>
        <textarea class="hunt-notes" placeholder="{{localize 'CAIN.HuntTracker.NotesPlaceholder'}}">{{hunt.notes}}</textarea>
      </div>

      {{!-- Hunt Controls --}}
      <div class="hunt-controls">
        <button type="button" data-action="resetMission" class="hunt-reset-btn" title="{{localize 'CAIN.HuntTracker.ResetMissionHint'}}">
          <i class="fas fa-redo"></i> {{localize "CAIN.HuntTracker.ResetMission"}}
        </button>
        <button type="button" data-action="endHunt" class="hunt-end-btn" title="{{localize 'CAIN.HuntTracker.EndHuntHint'}}">
          <i class="fas fa-flag-checkered"></i> {{localize "CAIN.HuntTracker.EndHunt"}}
        </button>
      </div>

    {{else}}
      {{!-- No Active Hunt --}}
      <div class="hunt-no-hunt">
        <p>{{localize "CAIN.HuntTracker.NoActiveHunt"}}</p>
        <button type="button" data-action="startHunt" class="hunt-start-btn" title="{{localize 'CAIN.HuntTracker.StartHuntHint'}}">
          <i class="fas fa-skull"></i> {{localize "CAIN.HuntTracker.StartHunt"}}
        </button>
      </div>

      {{!-- Quick Actions even without hunt --}}
      <div class="hunt-quick-actions">
        <button type="button" data-action="resetMission" class="hunt-reset-btn" title="{{localize 'CAIN.HuntTracker.ResetMissionHint'}}">
          <i class="fas fa-redo"></i> {{localize "CAIN.HuntTracker.ResetExorcists"}}
        </button>
      </div>
    {{/if}}
  {{else}}
    <div class="hunt-gm-only-notice">
      <p>{{localize "CAIN.HuntTracker.GmOnlyNotice"}}</p>
    </div>
  {{/if}}
</div>
